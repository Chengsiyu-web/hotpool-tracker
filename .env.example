# ══════════════════════════════════════════════════════════════
# Hotpool Tracker 环境变量配置
# 复制此文件为 .env 并填入实际值
# ══════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────
# 项目 URL 和 anon key（从 Supabase Dashboard > Settings > API 获取）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── AI Agent 服务 ──────────────────────────────────────────
# 本项目原始版本使用美团内部 CatX Agent API
# 开源版本已抽象为 AIService 接口，可接入任意 AI 服务
# 支持的 provider: "catx" | "openai" | "custom"
VITE_AI_PROVIDER=custom

# CatX Agent 配置（仅当 VITE_AI_PROVIDER=catx 时需填写）
VITE_CATX_BASE_URL=https://api.catx.sankuai.com
VITE_CATX_AGENT_ID=your-agent-id
VITE_CATX_ENV_ID=your-env-id
VITE_CATX_API_KEY=your-api-key
VITE_CATX_PROXY=https://nocode.sankuai.com/proxy/request

# OpenAI 兼容配置（仅当 VITE_AI_PROVIDER=openai 时需填写）
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_API_KEY=sk-your-openai-key
VITE_OPENAI_MODEL=gpt-4o

# ── 应用配置 ───────────────────────────────────────────────
# 扫榜热点数量
VITE_SCAN_TOP_N=15
# 每个热点生成创作方向数量
VITE_DIRECTIONS_PER_HOTSPOT=4
